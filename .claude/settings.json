{
  "worktree": {
    "baseRef": "head"
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.gradle"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(gradle:*)",
      "Bash(bash tools/check-conventions.sh)",
      "Bash(bash tools/hooks/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/pre-commit-gate.sh\"",
            "statusMessage": "Running gradle check before commit...",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
